{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stick Up Notes",
  "version": "1.0.0",
  "identifier": "com.nihilanthrope.stickupnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stick Up Notes",
        "label": "main",
        "width": 1100,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      },
      {
        "title": "Stick Up Note (Overlay)",
        "label": "overlay",
        "url": "/?mode=overlay",
        "width": 320,
        "height": 380,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
